# Copy to .env.local in the project root (or server/.env). Both are git-ignored.
# Never prefix secrets with VITE_ so they never enter the browser bundle.
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:8000
TERMINAL_PUBLIC_URL=http://localhost:8000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Optional: invite code instead of server/data/invite.txt
# TERMINAL_INVITE_CODE=replace-with-a-long-random-code

# Optional: comma-separated browser origins allowed to sign in
# TERMINAL_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
