# ── Google OAuth (Google Cloud Console → OAuth 2.0 Client) ─────────────
# Authorized redirect URI:  https://YOUR-VERCEL-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=520394158071-9c8vv5hnu19o0ppa019q3qqfas1vcqfi.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-a-rotated-secret

# ── NextAuth ──────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Supabase (server-side ONLY — never prefix with VITE_) ─────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace-with-rotated-secret-key

# ── Where the Terminal app is hosted (used for post-login redirect) ───
TERMINAL_APP_URL=http://localhost:8000
